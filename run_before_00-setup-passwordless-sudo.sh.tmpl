{{- if ne .chezmoi.username "root" -}}
#!/usr/bin/env sh

SUDOERS_FILE="/etc/sudoers.d/chezmoi-{{ .chezmoi.username }}"

# Check if file exists to skip password prompt if already done
if ! sudo test -f "$SUDOERS_FILE"; then
    echo "Setting up passwordless sudo..."
    echo "You will be asked for your password ONE last time."

    # Format: username ALL=(ALL) NOPASSWD: ALL
    CONFIG_LINE="{{ .chezmoi.username }} ALL=(ALL) NOPASSWD: ALL"

    # Create the file safely
    echo "$CONFIG_LINE" | sudo tee "$SUDOERS_FILE" > /dev/null
    sudo chmod 0440 "$SUDOERS_FILE"

    echo "Passwordless sudo enabled."
fi
{{- end -}}
