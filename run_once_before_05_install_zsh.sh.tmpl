#!/usr/bin/env sh

echo "=== Starting Clean Zsh Installation ==="

# 1. Install Zsh (Arch/Manjaro specific)
echo "[1/6] Installing Zsh..."
if ! command -v zsh &> /dev/null; then
    sudo pacman -Syu --noconfirm --needed zsh
else
    echo "Zsh is already installed."
fi

# 2. Prepare the clean directory structure
# We will put everything in ~/.config/zsh
echo "[2/6] Setting up directory structure at ~/.config/zsh..."
export ZDOTDIR="$HOME/.config/zsh"
mkdir -pv "$ZDOTDIR"

# 3. Install Oh My Zsh (OMZ) into the custom directory
# We set ZSH env var so OMZ installs there instead of ~/.oh-my-zsh
echo "[3/6] Installing Oh My Zsh..."
export ZSH="$ZDOTDIR/oh-my-zsh"

if [ -d "$ZSH" ]; then
    echo "Oh My Zsh is already installed in $ZSH. Skipping..."
else
    # --unattended: Don't start zsh immediately after install
    # --keep-zshrc: Don't replace existing zshrc if we are re-running
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
fi


# 4. Install Plugins (Autosuggestions, Syntax Highlighting, Completions)
echo "[4/6] Cloning plugins..."
ZSH_CUSTOM="$ZSH/custom"

# Helper function to clone plugins safely
install_plugin() {
    local name="$1"
    local repo="$2"
    if [ ! -d "$ZSH_CUSTOM/plugins/$name" ]; then
        echo "Cloning $name..."
        git clone --depth=1 "$repo" "$ZSH_CUSTOM/plugins/$name"
    else
        echo "$name already exists."
    fi
}

install_plugin "zsh-autosuggestions" "https://github.com/zsh-users/zsh-autosuggestions"
install_plugin "zsh-syntax-highlighting" "https://github.com/zsh-users/zsh-syntax-highlighting.git"
install_plugin "zsh-completions" "https://github.com/zsh-users/zsh-completions"

# 5. Configure .zshrc
echo "[5/6] Configuring .zshrc..."

# Move the default .zshrc generated by OMZ to our config folder if it ended up in HOME
if [ -f "$HOME/.zshrc" ]; then
    mv "$HOME/.zshrc" "$ZDOTDIR/.zshrc"
fi

TARGET_RC="$ZDOTDIR/.zshrc"

# Enable the plugins in .zshrc using sed (Search and Replace)
# We replace the default 'plugins=(git)' with our list
sed -i 's/plugins=(git)/plugins=(git zsh-autosuggestions zsh-syntax-highlighting zsh-completions)/' "$TARGET_RC"

# Fix the path to Oh My Zsh inside the .zshrc file
# Standard OMZ puts 'export ZSH=$HOME/.oh-my-zsh', we need to change that
sed -i "s|export ZSH=\$HOME/.oh-my-zsh|export ZSH=\$HOME/.config/zsh/oh-my-zsh|" "$TARGET_RC"

# 6. Create .zshenv to redirect Zsh to the new location
echo "[6/6] Linking ZDOTDIR..."
echo "export ZDOTDIR=\$HOME/.config/zsh" > "$HOME/.zshenv"

echo "=== Success! ==="
echo "1. Everything is installed in: ~/.config/zsh"
echo "2. A single file (~/.zshenv) points there."
echo "3. Please restart your terminal or type 'zsh' to see the changes."

sudo chsh -s $(which zsh) {{ .chezmoi.username }}
