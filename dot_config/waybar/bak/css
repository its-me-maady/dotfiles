/* General Styling */
* {
    font-family: "Font Awesome 6 Free", Roboto, Helvetica, Arial, sans-serif;
    font-size: 13px;
    border: none;
    box-shadow: none;
    transition: background-color 0.3s, color 0.3s;
}

/* Bar Background */
#waybar {
    background-color: rgba(30, 30, 46, 0.4);
    /* semi-transparent */
    color: #cdd6f4;
    padding: 4px 8px;
    border-radius: 10px;
}

/* Button Styling */
button {
    padding: 4px 10px;
    border-radius: 4px;
    background-color: transparent;
    color: inherit;
}

/* Workspaces */
#workspaces button {
    background-color: #313244;
    color: #cdd6f4;
    margin: 0 3px;
    padding: 5px 10px;
}

#workspaces button:hover {
    background-color: #45475a;
}

#workspaces button.focused,
#workspaces button.active {
    background-color: #89b4fa;
    color: #1e1e2e;
}

#workspaces button.urgent {
    background-color: #f38ba8;
    color: #1e1e2e;
}

/* Modules Margin */
#clock,
#battery,
#cpu,
#memory,
#pulseaudio,
#tray,
#mode,
#idle_inhibitor,
#window,
#workspaces {
    margin: 0 6px;
}

/* Battery Critical Warning */
@keyframes blink {
    to {
        background-color: #f38ba8;
        color: #1e1e2e;
    }
}

#battery.critical:not(.charging) {
    background-color: #f53c3c;
    color: #ffffff;
    animation: blink 0.5s linear infinite alternate;
}

/* Tray Items */
#tray>.passive {
    opacity: 0.5;
}

#tray>.needs-attention {
    background-color: #f38ba8;
    border-radius: 4px;
    padding: 2px;
}

/* Focus Styles */
label:focus {
    background-color: #11111b;
}

/* Remove extra margins on edge modules */
.modules-left>widget:first-child>#workspaces {
    margin-left: 0;
}

.modules-right>widget:last-child>#workspaces {
    margin-right: 0;
}

#custom-bluetooth {
    color: #00bfff;
    padding: 0 10px;
}

#custom-bluetooth.connected {
    color: #00ff00;
}

#custom-bluetooth.off {
    color: #ff0000;
}
