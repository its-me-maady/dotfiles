{
    "layer": "bottom",
        "position": "top",
        "height": 22,
        "spacing": 5,
        "modules-left": ["hyprland/mode"],
        "modules-center": ["hyprland/workspaces"],
        "modules-right": ["custom/bluetooth","cpu","battery","pulseaudio","clock","tray"],
        "sway/mode": {
            "format": "{}"
        },
        "sway/window": {
            "format": "{title}"
        },
        "hyprland/mode": {
            "format": "{}"
        },
        "cpu": { 
            "interval": 10, 
            "format": "CPU: {usage}%" 
        },
        "battery": {
            "bat": "BAT0",
            "states": {
                "good": 95,
                "warning": 30,
                "critical": 5
            },
            "format": "BAT0: {capacity}%",
            "format-charging": "BAT0: {capacity}% (charging)",
            "Format-plugged": "BAT0: {capacity}% (plugged)",
        },
        "clock": {
            "format": "{:%Y/%m/%d %H:%M}",
            "tooltip-format": "<tt><small>{calendar}</small></tt>",
            "calendar": {
                "format": {
                    "months": "<span color='#ffead3'><b>{}</b></span>",
                    "today": "<span color='#ff6699'><b>{}</b></span>"
                }
            }
        },
        "pulseaudio": {
            "format": "{icon} {volume}%",
            "format-icons": {
                "default": ["\uf026", "\uf027", "\uf028"]
            },
            "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
            "on-click-right": "pavucontrol",
            "format-muted": "\uf00d {volume}%"
        },
        "tray": {
            "icon-size": 20,
            "spacing": 10
        },
        "custom/bluetooth": {
            "format": "{}",
            "exec": "~/.config/waybar/scripts/bluetooth.sh",
            "interval": 10,
            "tooltip": false,
            "on-click": "~/.config/waybar/scripts/bluetooth_menu.sh"        
        },
}
