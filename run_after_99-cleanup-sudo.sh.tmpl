{{- if ne .chezmoi.username "root" -}}
#!/usr/bin/env sh

SUDOERS_FILE="/etc/sudoers.d/chezmoi-{{ .chezmoi.username }}"

# Check if the file exists before trying to delete it
if sudo test -f "$SUDOERS_FILE"; then
    echo "Cleanup: Revoking passwordless sudo rights..."
    
    # We use sudo rm, but since the file still exists, 
    # we still have passwordless sudo for this one last command!
    sudo rm "$SUDOERS_FILE"
    
    echo "Done. Sudo password is now required again."
fi
{{- end -}}
reboot
